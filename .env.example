# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요.
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# .env 는 .gitignore 에 포함되어 있으므로 커밋되지 않습니다.
# 이 파일(.env.example)에는 실제 키를 절대 넣지 마세요.

# ── Jev (TypeSafe AI) ─────────────────────────────
# 접근 경로: 공식 대기자 명단 또는 Vercel AI Gateway
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# ── 상용 LLM API (사용하는 것만 채우세요) ──────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Hugging Face (오픈소스 모델 다운로드/업로드) ────────
HF_TOKEN=
HF_HOME=./.cache/huggingface

# ── 로컬/자체 서빙 SLM (vLLM 등 OpenAI 호환 서버) ───────
SLM_BASE_URL=http://localhost:8001/v1
SLM_MODEL=

# ── 게이트웨이 ────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# 게이트웨이를 호출하는 클라이언트용 키 (직접 정한 임의의 긴 문자열)
# 비어 있으면 보호된 엔드포인트는 모든 요청을 401로 거부합니다.
GATEWAY_API_KEY=
# 요청당 출력 토큰 상한 (클라이언트가 더 크게 요청해도 이 값으로 제한)
MAX_OUTPUT_TOKENS=1024

# ── Provider 선택 ────────────────────────────────
# 기본값은 모두 오프라인 mock 입니다. 위에 키를 채워도 아래를 바꾸기 전에는 실제 호출이 없습니다.
SMALL_PROVIDER=mock          # mock | slm   (slm 이면 SLM_MODEL 필수)
FRONTIER_PROVIDER=mock       # mock | openai (openai 면 FRONTIER_MODEL, OPENAI_API_KEY 필수)
PROVIDER_TIMEOUT_S=30
# 상용 API (OpenAI 호환 엔드포인트만 지원)
FRONTIER_BASE_URL=https://api.openai.com/v1
FRONTIER_MODEL=
# 경로별 단가 (USD / 100만 토큰). mock·자체 서빙은 0
SMALL_PRICE_IN_PER_MTOK=0
SMALL_PRICE_OUT_PER_MTOK=0
FRONTIER_PRICE_IN_PER_MTOK=0
FRONTIER_PRICE_OUT_PER_MTOK=0

# ── 가드 / 라우터 임계값 (평가 모듈이 값을 바꿔 가며 측정합니다) ──
GUARD_MAX_INPUT_CHARS=8000
GUARD_BLOCK_INJECTION=true
ROUTER_LONG_PROMPT_CHARS=600
ROUTER_DEFAULT_CONFIDENCE=0.5
# 상용 모델로 보낼 키워드 (JSON 배열). 비워 두면 코드의 기본 목록 사용
# ROUTER_FRONTIER_KEYWORDS=["analyze","prove","step by step"]

# ── 저장소 ───────────────────────────────────────
# 1단계는 SQLite. PostgreSQL 은 평가(3단계) 전에 도입 예정 (postgresql://llmops:llmops@localhost:5432/llmops)
DATABASE_URL=sqlite:///./data/traces.sqlite3
# true 면 프롬프트 본문을 trace 에 저장합니다. 기본(false)은 길이·해시만 저장 (공개 레포, 개인정보 보호)
TRACE_STORE_CONTENT=false
VECTOR_DB_URL=http://localhost:6333

# ── 수동 실호출 스모크 (scripts/smoke_live.py) ─────────
# 비용이 드는 실제 호출을 허용하는 스위치입니다. 여기에 넣지 말고, 실행하는 셸에서만 지정하세요.
#   PowerShell: $env:ALLOW_LIVE_CALLS = "1"; uv run python -m scripts.smoke_live --target slm
# ALLOW_LIVE_CALLS=1
