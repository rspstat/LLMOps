# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요.
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# .env 는 .gitignore 에 포함되어 있으므로 커밋되지 않습니다.
# 이 파일(.env.example)에는 실제 키를 절대 넣지 마세요.

# ── Jev (TypeSafe AI) ─────────────────────────────
# 접근 경로: 공식 대기자 명단 또는 Vercel AI Gateway
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# ── 상용 LLM API (사용하는 것만 채우세요) ──────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Hugging Face (오픈소스 모델 다운로드/업로드) ────────
HF_TOKEN=
HF_HOME=./.cache/huggingface

# ── 로컬/자체 서빙 SLM (vLLM 등 OpenAI 호환 서버) ───────
SLM_BASE_URL=http://localhost:8001/v1
SLM_MODEL=

# ── 게이트웨이 ────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# 게이트웨이를 호출하는 클라이언트용 키 (직접 정한 임의의 긴 문자열)
GATEWAY_API_KEY=

# ── 저장소 ───────────────────────────────────────
DATABASE_URL=postgresql://llmops:llmops@localhost:5432/llmops
VECTOR_DB_URL=http://localhost:6333
